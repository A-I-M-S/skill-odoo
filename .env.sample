# ── Odoo connection ──────────────────────────────────────────────
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_LOGIN=you@example.com
ODOO_API_KEY=your_odoo_api_key

# ── Accounting policy ────────────────────────────────────────────
SHAREHOLDER_ACCOUNT_CODE=202040
SHAREHOLDER_ACCOUNT_NAME=Shareholder Notes Payable
JOURNAL_TYPE=general
JOURNAL_CODE=
JOURNAL_NAME=
MONTHLY_CONSOLIDATE=true
MOVE_REF_FORMAT=%y%b
MOVE_NAME_FROM_REF=true

# ── Classifier (OpenAI-compatible chat completions) ──────────────
AI_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=google/gemma-4-26b-a4b-it:free
AI_SECRET=your_openrouter_api_key
AI_PROVIDER_ORDER=google-ai-studio
DEFAULT_CURRENCY=SGD

# ── FX (Frankfurter, free, no key) ───────────────────────────────
FX_PROVIDER=frankfurter
FX_BASE_CURRENCY=SGD

# ── OCR ──────────────────────────────────────────────────────────
# OCR_PROVIDER:
#   openai     - any OpenAI-compatible vision endpoint (recommended)
#   tesseract  - local OCR only (offline fallback)
OCR_PROVIDER=openai
OCR_BASE_URL=https://openrouter.ai/api/v1
OCR_MODEL=google/gemma-4-26b-a4b-it:free
OCR_API_KEY=sk-or-v1-your_openrouter_key

# ── Inbox / data folders ─────────────────────────────────────────
RECEIPTS_INBOX=./tmp/incoming_receipts
RECEIPTS_PROCESSED_DELETE=true
AUDIT_LOG_DIR=./tmp/audit_logs

# ── Telegram receipt bot ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:replace_me
# Comma-separated numeric IDs. If blank, bot only replies with your ID and refuses processing.
TELEGRAM_ALLOWED_USER_IDS=
# Optional comma-separated usernames without @
TELEGRAM_ALLOWED_USERNAMES=
TELEGRAM_POLL_TIMEOUT=50
TELEGRAM_OFFSET_FILE=tmp/.telegram_offset
